# Copiez ce fichier sous le nom « .env », puis remplissez-le.
# Le fichier .env ne doit jamais être envoyé sur GitHub (il est ignoré par git).

# Identifiant et mot de passe demandés à l'ouverture de la plateforme.
# Choisissez un mot de passe long : l'application refuse de démarrer s'il est vide.
YAME_UTILISATEUR=yame
YAME_MOT_DE_PASSE=

# Nom de domaine, seulement si vous activez le HTTPS automatique (voir DEPLOIEMENT.md).
YAME_DOMAINE=

# --- Agent IA (facultatif) ---
# Clé d'API Anthropic. Sans elle, l'agent IA et l'atelier de R&D sont désactivés ;
# le reste de la plateforme fonctionne. Chaque travail de l'agent est facturé à l'usage.
YAME_IA_CLE=
# Modèle utilisé. Laisser vide pour le choix par défaut.
YAME_IA_MODELE=
# Recherche web par l'agent : laisser vide pour la désactiver (voir DEPLOIEMENT.md).
YAME_IA_RECHERCHE_WEB=
# Nombre maximal d'allers-retours par travail : borne le coût d'un travail.
YAME_IA_TOURS_MAX=40
